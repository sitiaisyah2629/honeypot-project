# 1. Refresh your package index and upgrade existing software to current versions
sudo apt update && sudo apt upgrade -y
+-y for 'yes'. Without -y, the command pauses indefinitely in an automated environment, waiting for a human to confirm.

# 2. Install utility tools required to download files securely over HTTPS
sudo apt install -y curl ca-certificates gnupg
+This trio is usually the prerequisite step before adding third-party repositories (like Docker, Node.js, or PostgreSQL) to your system.
+curl downloads the third-party GPG security key or repository file.
+ca-certificates ensures the connection to download that key is secure and trusted.
+gnupg imports and decrypts/verifies the security key so apt can safely install software from that new source.

# 3. Create a secure folder to store Docker's official encryption key
sudo install -m 0755 -d /etc/apt/keyrings

# 4. Download Docker's official GPG key so Ubuntu trusts the software source
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg

# 5. Grant read permissions to the cryptographic key
sudo chmod a+r /etc/apt/keyrings/docker.gpg

# 6. Add Docker's official repository to your Ubuntu software sources list
echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
  $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
  sudo tee /etc/apt/sources.list.d/docker.list > /dev/null

# 7. Update software lists again and install Docker Engine plus the Compose plugin
sudo apt update
sudo apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# 8. Grant your current user permission to run Docker commands without 'sudo'
sudo usermod -aG docker $USER
newgrp docker
