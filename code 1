# 1. Refresh your package index and upgrade existing software to current versions
sudo apt update && sudo apt upgrade -y
+-y for 'yes'. Without -y, the command pauses indefinitely in an automated environment, waiting for a human to confirm.

# 2. Install utility tools required to download files securely over HTTPS
sudo apt install -y curl ca-certificates gnupg
+This trio is usually the prerequisite step before adding third-party repositories (like Docker, Node.js, or PostgreSQL) to your system.
+curl downloads the third-party GPG security key or repository file.
+ca-certificates ensures the connection to download that key is secure and trusted.
+gnupg imports and decrypts/verifies the security key so apt can safely install software from that new source.

# 3. Create a secure folder to store Docker's official encryption key
sudo install -m 0755 -d /etc/apt/keyrings
+sudo: Runs the command with root (administrator) privileges, which is required to write to /etc.
+install: A utility used to copy files and create directories while simultaneously setting ownership and permissions.
+-m 0755: Sets the directory permissions:
-7 (Owner/Root): Full access (Read, Write, Execute).
-5 (Group): Read and Execute (can view directory contents).
-5 (Others): Read and Execute (can view directory contents).
+the -m flag in install (and chmod) accepts two types of permission formats, not just octal notation
+-d: Tells install to create a directory (and any missing parent directories) rather than copying a file.
+/etc/apt/keyrings: The target directory path.

# 4. Download Docker's official GPG key so Ubuntu trusts the software source
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg
+curl: Downloads the raw GPG key file from Docker's servers.
+-f (fail quietly): Returns an error immediately if the server request fails (e.g., a 404 error) instead of outputting raw HTML error pages.
+-s (silent): Hides the progress bar and error messages.
+-S (show error): Tells curl to show error messages only if the command fails, even though -s is active.
+-L (location): Follows any HTTP redirects if the URL has moved.
+| (pipe): Takes the text downloaded by curl and feeds it directly into the next command as input.
+sudo gpg: Runs the GNU Privacy Guard tool with administrative privileges.
+--dearmor: Converts the key from human-readable text (ASCII-armored) into binary format, which apt processes much faster.
+-o /etc/apt/keyrings/docker.gpg: Specifies the output file path where the converted binary key will be stored.

# 5. Grant read permissions to the cryptographic key
sudo chmod a+r /etc/apt/keyrings/docker.gpg

# 6. Add Docker's official repository to your Ubuntu software sources list
echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
  $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | \
  sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
+Inside the echo command, three dynamic commands run to auto-detect your system details:
+arch=$(dpkg --print-architecture): Detects your system's hardware architecture (e.g., amd64, arm64, or armhf) so apt downloads the correct binaries.
+signed-by=/etc/apt/keyrings/docker.gpg: Explicitly links this repository to the GPG key you downloaded in the previous step. This ensures apt only trusts Docker packages signed by 
this specific key.
+$(. /etc/os-release && echo "$VERSION_CODENAME"): Reads your Linux OS configuration file and inserts your Ubuntu release codename (e.g., jammy, noble, or focal) so you get packages 
built for your exact OS version.
+| (pipe): Sends the text output from echo to tee.
+sudo tee /etc/apt/sources.list.d/docker.list: tee takes the input text and writes it into a file. Using sudo allows it to write to system-protected /etc/apt/ directories 
(a plain > redirect wouldn't work with sudo).
+> /dev/null: Redirects the standard output to "nothing" so the command runs silently without printing the created string to your terminal screen.

# 7. Update software lists again and install Docker Engine plus the Compose plugin
sudo apt update
sudo apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# 8. Grant your current user permission to run Docker commands without 'sudo'
sudo usermod -aG docker $USER
