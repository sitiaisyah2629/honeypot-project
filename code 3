version: '3.8'
#Explanation: Specifies the Docker Compose file format standard, unlocking compatibility with modern features like bridge networks and shared volumes.

networks:
  soc-network:
    driver: bridge
#Explanation: Creates an isolated virtual bridge network inside Docker. Containers connected to soc-network can resolve each other by container name (e.g., promtail can 
#reach loki simply by addressing http://loki:3100).

volumes:
  cowrie-logs:
  grafana-data:
  crowdsec-db:
  crowdsec-config:
#cowrie-logs: A shared virtual folder where Cowrie outputs logs, allowing Promtail and CrowdSec to read them simultaneously.
#grafana-data: Stores your customized dashboards, user preferences, and data source links so they persist across container restarts.
#crowdsec-db & crowdsec-config: Retains CrowdSec's threat database, active IP bans, and downloaded detection scenarios.

services:
  # 1. THE DECOY TRAP
  cowrie:
    image: cowrie/cowrie:latest
    container_name: cowrie_honeypot
    ports:
      - "2222:2222"
    volumes:
      - cowrie-logs:/cowrie/cowrie-git/var/log/cowrie
    networks:
      - soc-network
    restart: always
#image: cowrie/cowrie:latest: Downloads the official Cowrie honeypot image from Docker Hub.
#ports: "2222:2222": Maps port 2222 on your physical Ubuntu VM to port 2222 inside the container.
#volumes: Connects the container's internal log folder to the shared cowrie-logs storage volume.
#restart: always: Ensures the honeypot automatically restarts if it crashes or if the VM reboots.

  # 2. THE SEARCH DATABASE
  loki:
    image: grafana/loki:latest
    container_name: loki_db
    ports:
      - "3100:3100"
    volumes:
      - ./loki/loki-config.yaml:/etc/loki/loki-config.yaml
    command: -config.file=/etc/loki/loki-config.yaml
    networks:
      - soc-network
    restart: always
#volumes: Mounts your custom local loki-config.yaml file into the container at /etc/loki/loki-config.yaml.
#command: Instructs Loki to launch using your specified configuration file instead of its built-in defaults.

  # 3. THE LOG SHIPPER
  promtail:
    image: grafana/promtail:latest
    container_name: promtail_shipper
    volumes:
      - ./promtail/promtail-config.yaml:/etc/promtail/promtail-config.yaml
      - cowrie-logs:/var/log/cowrie:ro
    command: -config.file=/etc/promtail/promtail-config.yaml
    networks:
      - soc-network
    depends_on:
      - loki
      - cowrie
    restart: always
#cowrie-logs:/var/log/cowrie:ro: Mounts the shared log volume in Read-Only (ro) mode. This allows Promtail to parse Cowrie's logs without the risk of modifying or deleting them.
#depends_on: Ensures Promtail waits until both loki and cowrie containers are running before starting up.

  # 4. THE VISUAL DASHBOARD
  grafana:
    image: grafana/grafana:latest
    container_name: grafana_dashboard
    ports:
      - "3000:3000"
    volumes:
      - grafana-data:/var/lib/grafana
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=admin
    networks:
      - soc-network
    depends_on:
      - loki
    restart: always
#ports: "3000:3000": Opens port 3000 so you can access the Grafana web dashboard via your browser at http://localhost:3000.
#environment: GF_SECURITY_ADMIN_PASSWORD=admin: Automatically initializes the default administrator password to admin.

  # 5. THE AUTOMATED DEFENSE ENGINE
  crowdsec:
    image: crowdsecurity/crowdsec:latest
    container_name: crowdsec_defense
    environment:
      - COLLECTIONS=crowdsecurity/linux crowdsecurity/cowrie
    volumes:
      - crowdsec-db:/var/lib/crowdsec/data
      - crowdsec-config:/etc/crowdsec
      - cowrie-logs:/var/log/cowrie:ro
    networks:
      - soc-network
    restart: always
#COLLECTIONS=crowdsecurity/linux crowdsecurity/cowrie: Downloads predefined detection scenarios designed to analyze Linux SSH authentication behavior and Cowrie honeypot logs.
#cowrie-logs:/var/log/cowrie:ro: Grants CrowdSec read-only access to Cowrie's live logs to detect brute-force attacks and flag malicious IPs in real time.
